{
  "name": "shoot-cc",
  "version": "0.1.0",
  "description": "No cap, for real. Stops AI coding agents from claiming \"done\" unless it can actually prove it. Zero dependencies.",
  "keywords": [
    "claude-code",
    "codex-cli",
    "hooks",
    "verification",
    "ai-agents",
    "agent-verification",
    "developer-tools",
    "cli",
    "testing"
  ],
  "license": "MIT",
  "author": "CosmicShreyas (https://github.com/CosmicShreyas)",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "shoot": "dist/cli.js"
  },
  "files": [
    "dist/**/*.js",
    "!dist/**/*.map",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "cd dist-tests && node --import ./tests/setup.js --test",
    "pretest": "tsc -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CosmicShreyas/Shoot.git"
  },
  "bugs": {
    "url": "https://github.com/CosmicShreyas/Shoot/issues"
  },
  "homepage": "https://github.com/CosmicShreyas/Shoot#readme"
}
